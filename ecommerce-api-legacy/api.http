@baseUrl = http://localhost:3000
# Valor de ADMIN_TOKEN configurado no ambiente (ver .env.example)
@adminToken = troque-pelo-seu-token

### Checkout - sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "123",
  "c_id": 1,
  "card": "5111222233334444"
}

### Relatório financeiro administrativo (exige X-Admin-Token)
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Deletar usuário (exige X-Admin-Token)
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
