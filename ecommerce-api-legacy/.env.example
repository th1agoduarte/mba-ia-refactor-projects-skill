# Copie para .env (opcional). src/config/index.js carrega ./.env se existir;
# variáveis já definidas no ambiente têm precedência. A aplicação sobe sem .env.

# Porta HTTP do servidor (src/config/index.js → src/app.js). Padrão: 3000.
PORT=3000

# Caminho do banco SQLite (src/database/connection.js). ":memory:" (padrão) recria schema e seed a cada boot.
# Com um arquivo (ex.: lms.db), o schema é criado se não existir e o seed só roda com a tabela users vazia.
DB_PATH=:memory:

# Token exigido no header X-Admin-Token por GET /api/admin/financial-report e DELETE /api/users/:id
# (src/middlewares/adminAuth.js). Vazio = endpoints administrativos desabilitados (403).
# Gere um valor forte, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Chave do gateway de pagamento (src/services/paymentGateway.js). Vazia = gateway simulado
# (cartão iniciado em 4 é aprovado). Nunca coloque a chave no código.
PAYMENT_GATEWAY_KEY=

# Nível de log (src/config/logger.js): error | warn | info | debug. Padrão: info.
LOG_LEVEL=info
