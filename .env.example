# Configuração do AGENTE que executa a skill /refactor-arch (Claude Code).
# O repositório base não traz .env.example: os 3 projetos legados não leem
# variáveis de ambiente. Os .env.example de cada projeto refatorado são gerados
# pela própria skill na Fase 3 (SECRET_KEY, ADMIN_TOKEN, PORT...).
#
# `make env` cria o .env a partir deste arquivo e preenche os valores vazios com
# o .env raiz de technical-challenges/. O .env é gitignored.
#
# Escolha do provider por execução, sem editar este arquivo:
#   make skill P=1                    # Claude Code com o login atual (padrão)
#   make skill P=1 PROVIDER=anthropic # Claude Code com ANTHROPIC_API_KEY
#   make skill P=1 PROVIDER=aws       # Claude Code no AWS Bedrock
#   make skill P=1 PROVIDER=google    # Claude Code -> gateway LiteLLM -> Gemini
#   make skill P=1 PROVIDER=openai    # Claude Code -> gateway LiteLLM -> OpenAI

# --------------------------------------------------------------------------- #
# Modelo do agente                                                             #
# --------------------------------------------------------------------------- #

# Modelo do Claude Code na execução da skill (--model). Vazio = padrão da conta.
# Modelos: https://docs.anthropic.com/en/docs/about-claude/models
CLAUDE_MODEL=

# Presets por provider, usados por `make skill PROVIDER=<p>`. Os nomes mudam com
# frequência: confira na documentação de cada provider.
GOOGLE_LLM_MODEL=gemini-3.5-flash
OPENAI_LLM_MODEL=
ANTHROPIC_LLM_MODEL=claude-sonnet-5-5
# Model ID ou inference profile do Bedrock (ex.: "us.anthropic....")
AWS_LLM_MODEL=

# --------------------------------------------------------------------------- #
# Gateway LiteLLM (Docker) — só para PROVIDER=google|openai                    #
# --------------------------------------------------------------------------- #

# O Claude Code fala a API da Anthropic. O LiteLLM expõe essa mesma API
# (/v1/messages) e traduz para Gemini/OpenAI. O Makefile aponta
# ANTHROPIC_BASE_URL para o gateway e usa esta chave como ANTHROPIC_AUTH_TOKEN.
# Precisa começar com "sk-". `make env` gera uma aleatória.
LITELLM_MASTER_KEY=

# Porta local do gateway (http://localhost:4000).
GATEWAY_PORT=4000

# --------------------------------------------------------------------------- #
# Credenciais por provider (preencha só a do provider escolhido)               #
# --------------------------------------------------------------------------- #

# Google Gemini (via gateway) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI (via gateway) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic direto — https://console.anthropic.com/settings/keys
# Vazio = o Claude Code usa o login da sua conta (claude /login).
ANTHROPIC_API_KEY=

# AWS Bedrock — credenciais IAM com o modelo liberado em Bedrock > Model access.
# Alternativa: AWS_PROFILE apontando para ~/.aws/credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
AWS_REGION=us-east-1
