# Configuração da API da Loja. Lida por src/config/settings.py (os.environ).
# Nenhuma variável é obrigatória: a aplicação sobe com os defaults abaixo.
# A app não carrega arquivo .env sozinha: exporte as variáveis no shell
# (ex.: `set -a; . ./.env; set +a; python app.py`) ou defina-as no ambiente de execução.

# Chave de assinatura do Flask (sessões/cookies). Vazia = chave aleatória gerada a cada boot (com aviso no log).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Token exigido no header X-Admin-Token por POST /admin/reset-db e POST /admin/query.
# Vazio = endpoints administrativos desabilitados (respondem 403).
ADMIN_TOKEN=

# Caminho do arquivo SQLite. Criado e populado (seed) no primeiro boot.
DATABASE_PATH=loja.db

# Endereço do servidor. Padrão 0.0.0.0, o mesmo do sistema legado; use 127.0.0.1 para aceitar só conexões locais.
HOST=0.0.0.0
PORT=5000

# Debug do Flask/Werkzeug (1 = ligado). Nunca ligue em ambiente exposto: o debugger permite executar código.
FLASK_DEBUG=0

# Origens liberadas no CORS, separadas por vírgula. Padrão * (todas), como no sistema legado; restrinja em produção (ex.: https://app.exemplo.com).
CORS_ORIGINS=*

# Nível de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Nome do ambiente exibido em GET /health.
APP_ENV=producao
