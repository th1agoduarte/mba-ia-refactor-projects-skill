# Copie para .env e ajuste. Todas as variáveis são opcionais: a aplicação sobe sem .env.
# Lidas em config/settings.py.

# Banco SQLAlchemy. Caminho relativo do SQLite fica em instance/ (padrão: instance/tasks.db).
DATABASE_URL=sqlite:///tasks.db

# Chave que assina os tokens de login. Vazia = chave aleatória a cada boot (aviso no log; tokens expiram ao reiniciar).
SECRET_KEY=
# Validade dos tokens de login, em segundos (padrão: 8 h).
TOKEN_MAX_AGE=28800

# Credencial de administrador para DELETE /users/<id> e para criar/alterar papéis (role != user).
# Enviada como "Authorization: Bearer <ADMIN_TOKEN>". Vazia = só tokens de login de usuários admin são aceitos.
ADMIN_TOKEN=

# Servidor HTTP (python app.py). Debug fica desligado por padrão; FLASK_DEBUG=1 só em desenvolvimento local.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO

# Origens liberadas no CORS, separadas por vírgula (ex.: http://localhost:3000). Vazia = CORS desligado.
CORS_ORIGINS=

# E-mail de notificação de task atribuída. SMTP_HOST vazio = notificações só registradas no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
